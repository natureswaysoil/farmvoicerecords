NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Server-only: configure separate sandbox and production values.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_MONTHLY_PRICE_ID=
STRIPE_CORE_ANNUAL_PRICE_ID=
STRIPE_H2A_MONTHLY_PRICE_ID=
STRIPE_H2A_ANNUAL_PRICE_ID=
AI_GATEWAY_API_KEY=
FARMVOICE_EXTRACTION_MODEL=openai/gpt-6.1-sol
FARMVOICE_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
# Optional CDN origin. Keep empty to serve bundled public videos.
NEXT_PUBLIC_VIDEO_BASE_URL=

# QuickBooks Online (server-only). Use sandbox credentials in previews.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_TOKEN_ENCRYPTION_KEY=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback

# John Deere (server-only; URLs/scopes from the approved Developer Portal app).
JOHN_DEERE_CLIENT_ID=
JOHN_DEERE_CLIENT_SECRET=
JOHN_DEERE_AUTH_URL=
JOHN_DEERE_TOKEN_URL=
JOHN_DEERE_API_BASE_URL=
JOHN_DEERE_TOKEN_ENCRYPTION_KEY=
JOHN_DEERE_REDIRECT_URI=http://localhost:3000/api/integrations/john-deere/callback
JOHN_DEERE_SCOPES=

# Edge Function environment only; configure in Supabase, not NEXT_PUBLIC_*.
RESEND_API_KEY=
FARMVOICE_NOTIFICATION_FROM=FarmVoice Records <notifications@farmvoicerecords.com>
# The cron shared secret is in Supabase Vault, never this browser environment.
